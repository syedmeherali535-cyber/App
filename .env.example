# ---------------------------------------------------------------------------
# Meher EMB — environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Port the API/website server listens on.
PORT=3000

# --- Administrator login -----------------------------------------------------
# Required. Choose ONE of the two options below. Without either one the admin
# dashboard stays locked and shows a setup notice (no default password exists).
# Minimum 10 characters.
ADMIN_PASSWORD=
# Optional stronger alternative: `npm run hash-password -- "your password"`
# ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Use a long random string (32+ chars).
# If omitted a temporary secret is generated at boot and admins must log in
# again after every restart.
SESSION_SECRET=

# --- Email notifications (optional) -----------------------------------------
# Leave empty to keep notifications disabled. The admin dashboard then clearly
# reports "email not configured" and no message is ever reported as sent.
# Supported provider: Resend (https://resend.com)
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# --- Storage ----------------------------------------------------------------
# SQLite database file and private upload directory (defaults shown).
DATABASE_PATH=./data/meher-emb.db
UPLOAD_DIR=./data/uploads
